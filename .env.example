# Copy to .env (never commit .env).

# sandbox = real 1Click prices, simulated payments (no funds needed)
# live    = NEAR mainnet, real funds (NEAR Intents has no testnet)
INTENTS_MODE=sandbox

# Your mainnet NEAR account that receives payments. Required for live mode.
MERCHANT_ACCOUNT=
# INTENTS = credit your NEAR Intents balance (no setup, no withdrawal fee)
# DESTINATION_CHAIN = send USDC to your NEAR wallet (the account must be registered on the USDC
# contract first; the plugin refuses to save otherwise)
RECIPIENT_TYPE=INTENTS

# Optional 1Click partner JWT (https://partners.near-intents.org). Without it 1Click adds a fee.
INTENTS_CHECKOUT_JWT=

STORE_CURRENCY=EUR
WP_PORT=8080
STORE_URL=http://localhost:8080
